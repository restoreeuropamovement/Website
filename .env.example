# Restore Europa Movement — environment
#
# Copy to `.env.local` for development, or paste into the Vercel project's
# Environment Variables. No variable here has a default in code: `lib/admin/env.ts`
# throws when one is missing, because a secret with a fallback is a published
# credential.
#
# The public site builds and serves with NONE of these set. Everything below is
# needed only for the two public forms and the administrative surface; without
# them those decline politely rather than failing.


# ---------------------------------------------------------------------------
# Public
# ---------------------------------------------------------------------------

# The origin visitors actually reach — scheme included, no trailing slash.
# Canonical URLs, hreflang, the sitemap and Open Graph tags are all built from it.
# `lib/site.ts` defaults to https://restoreeuropa.eu, so set this only where the
# real origin differs: a preview deployment, or a staging host.
#
# Serve the apex and redirect www to it, so pages are not indexed at two
# addresses and ADMIN_ORIGIN has one value to match.
NEXT_PUBLIC_SITE_URL="https://restoreeuropa.eu"

# Whether to believe `x-forwarded-for` and `x-real-ip`.
#
# Leave this unset on Vercel. The platform writes `x-vercel-forwarded-for` and
# strips it from the incoming request, so it is the one address header a caller
# cannot forge, and `lib/admin/request.ts` reads it first regardless.
#
# Set it to "true" ONLY behind a reverse proxy you control that overwrites the
# two headers above. They are ordinary request headers: where nothing overwrites
# them they are whatever the client typed, and a client choosing its own
# rate-limit bucket has no rate limit — a fresh allowance per request on the
# sign-in ceremony, the elevation ceremony, both public forms and the beacon.
#
# Unset behind such a proxy, every visitor shares one anonymous bucket. That is
# stricter than the truth rather than looser, which is the direction this should
# fail in.
# TRUST_PROXY_HEADERS="true"


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Postgres. On Vercel, add a Postgres integration and it supplies this.
# Locally, `npm run db:dev` starts one with nothing to install:
#   DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5433/postgres"
#   DATABASE_SSL="disable"
#
# An `sslmode` parameter on this URL is ignored: `lib/db.ts` connects with
# `verify-full` and postgres.js lets the option win, so the server's certificate
# is always checked and no query parameter can turn that off.
DATABASE_URL="postgres://…"

# Only for a local server with no TLS, such as the loopback socket `npm run
# db:dev` opens. Refused outright when NODE_ENV is production, rather than
# honoured: this variable switches off transport security, and one left set by
# accident is not something anybody notices.
# DATABASE_SSL="disable"


# ---------------------------------------------------------------------------
# Membership and correspondence
# ---------------------------------------------------------------------------

# AES-256-GCM key for the identifying fields of a member record and for the
# bodies of contact-form messages. 32 bytes, base64url:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
#
# This key is NOT stored in the database, and that is the whole point: a stolen
# copy of the database decrypts to nothing without it. Losing it means losing
# every name, address, region and message already stored — they cannot be
# recovered. Keep a copy somewhere a disk failure cannot reach.
#
# Rotating it is a migration, not an edit: decrypt under the old key, re-encrypt
# under the new. `npm run db:rotate-key` does that; see the next variable.
MEMBER_ENCRYPTION_KEY=""

# The key being rotated away from. Set ONLY while a rotation is in progress.
#
# While it is set, values written under either key can still be read and either
# key's digests still match, so an interrupted rotation leaves a working site
# rather than an unreadable table. The sequence is:
#
#   1. Move the current key here, put the new one in MEMBER_ENCRYPTION_KEY.
#   2. `npm run db:rotate-key`            (dry run — prints what it would do)
#   3. `npm run db:rotate-key -- --commit`
#   4. Redeploy, check the admin surface reads, then unset this and redeploy.
#
# Step 4 breaks the unsubscribe links in newsletter issues already sent: those
# tags are derived from the key rather than stored, so they cannot be re-wrapped.
# MEMBER_ENCRYPTION_KEY_PREVIOUS=""


# ---------------------------------------------------------------------------
# Administrative surface (/admin)
# ---------------------------------------------------------------------------

# Signs the session cookie. At least 32 characters:
#   node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
# Separate from MEMBER_ENCRYPTION_KEY on purpose — rotating sessions should not
# orphan the membership roll.
ADMIN_SESSION_SECRET=""

# Exact origin the admin surface is served from, for WebAuthn. Scheme included,
# no trailing slash, and it must match what the browser shows or passkeys fail.
ADMIN_ORIGIN="https://restoreeuropa.eu"

# The WebAuthn relying party: a bare registrable domain. No scheme, no port, no
# subdomain — "restoreeuropa.eu", never "https://restoreeuropa.eu" and never
# "www.restoreeuropa.eu".
#
# A passkey is cryptographically bound to this value. Changing it orphans every
# credential already enrolled, so set it to the final domain BEFORE enrolling
# the first passkey. Enrolling against a *.vercel.app preview and then moving to
# the real domain means starting again.
ADMIN_RP_ID="restoreeuropa.eu"

# Token permitting the very first passkey to be enrolled at /admin/enrol.
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
#
# It is honoured only while no credential exists; once one passkey is enrolled
# the token is inert and further passkeys can be added only from an already
# authenticated session. Removing it afterwards is tidy rather than necessary.
ADMIN_BOOTSTRAP_TOKEN=""

# Hides the admin surface from anyone who has not been told it is there.
#   node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
#
# Optional. Unset, /admin behaves normally. Set, every path under /admin and
# /api/admin answers with the site's ordinary 404 — the real one, byte for byte,
# for every HTTP method — until a browser presents this value once as
#
#   https://restoreeuropa.eu/admin/login?k=THE-VALUE
#
# which sets a six-month cookie and redirects to the clean URL so the value does
# not linger in history or a bookmark. Invitation links generated in
# /admin/security carry it automatically.
#
# READ THIS BEFORE RELYING ON IT. This is not a security control and nothing
# else may be relaxed because it is on. The passkey is what protects /admin;
# this is a curtain in front of that door, and anyone who learns the value still
# cannot open it. What it actually buys is that a scanner cannot reach the
# pre-authentication code at all, and that a failed sign-in in the audit log is
# now somebody who was invited rather than background noise.
#
# Rotating ADMIN_SESSION_SECRET closes the curtain on every browser at once,
# which is the remedy if the value is ever forwarded to the wrong person.
# ADMIN_VEIL_SECRET=""


# ---------------------------------------------------------------------------
# Downloadable materials
# ---------------------------------------------------------------------------

# Read and write access to the Vercel Blob store holding the files offered at
# /materials — logos, posters, stickers, wallpapers and images for the accounts.
#
# Vercel -> the project -> Storage -> Create -> Blob. Creating the store issues
# this token; there is nothing else to configure and no bucket name to match.
#
# Needed only to upload and to withdraw. Files already published are rows in
# the database plus addresses the store already serves to anybody, so the
# public page reads them without it and must never be given it. Without this
# set, /admin/materials lists what exists and says plainly that it cannot add
# to it.
#
# The objects are stored with public access, deliberately: the value of a logo
# pack is that people use it correctly, and an identity behind a login is an
# identity drawn wrong from a screenshot.
BLOB_READ_WRITE_TOKEN=""


# ---------------------------------------------------------------------------
# Mail, and the work that runs on a schedule
# ---------------------------------------------------------------------------

# Transactional mail, through Resend. Optional, and genuinely optional: without
# it the acknowledgement to an applicant is skipped and the application is still
# recorded, because losing somebody's application because a third party was
# unreachable would be the worse failure by a wide margin.
#
# MAIL_FROM must be an address on a domain verified with the provider, or every
# message is rejected outright. Fill in one that exists; there is no default.
# RESEND_API_KEY=""
# MAIL_FROM=""

# Where to tell a human that something happened.
#
# Read this before treating the alerting as switched on. A passkey enrolled or
# removed, an invitation issued or claimed, a session replayed from the wrong
# browser, a run of failed sign-ins and an audit chain that stops verifying are
# all mailed here the moment they happen — and with this unset every one of them
# is recorded and nobody is told. That is a supported state and it is not an
# obvious one: the surface behaves identically either way, so the failure looks
# exactly like a system that is watching.
#
# A mailbox a person actually reads, and not a shared alias nobody owns. The
# messages carry no names, addresses or identifiers — see lib/admin/alerts.ts
# for why the list of events is deliberately short.
# MAIL_NOTIFY_TO=""

# Authorises the two scheduled jobs in vercel.json: the nightly traffic archive
# and the Monday security digest. Vercel sets this itself once cron jobs are
# configured; set it by hand to run either endpoint from anywhere else.
#
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
#
# No default, and each endpoint refuses to run rather than running unauthorised
# when it is missing. Both compare it in constant time.
#
# Unset, the digest never runs — so the audit chain is never verified over its
# whole length, and the weekly message whose absence is meant to be informative
# is absent every week.
# CRON_SECRET=""


# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------

# The admin dashboard reads real traffic figures from the Vercel API. Without
# these it reports the figures as unavailable rather than estimating them. The
# movement's own figures — applications, enquiries, the pipeline — come from our
# database and appear whether or not this section is filled in.
#
# Three steps, and the first is the one that is easy to miss: collection and
# reading are separate. `@vercel/analytics` is already mounted in
# components/layout/SiteChrome.tsx, so visits are recorded as soon as Web
# Analytics is switched on for the project — but the dashboard cannot read them
# back without a token.
#
#   1. Vercel → the project → Analytics → Enable. Nothing is collected until
#      this is done, and the API then has nothing to return.
#   2. Vercel → account settings → Tokens → create one scoped to the team or
#      project. This is a credential for the whole project: treat it like the
#      others here, and never commit it.
#   3. Project ID: Vercel → the project → Settings → General. TEAM_ID is needed
#      only when the project belongs to a team rather than a personal account.
#
# VERCEL_ANALYTICS_TOKEN=""
# VERCEL_PROJECT_ID=""
# VERCEL_TEAM_ID=""
